# ==========================================
# JPLensAIContext - Configuration
# ==========================================

# 🔑 REQUIRED: Choose your AI provider and specific model
AI_PROVIDER=openai  # Options: "openai" or "claude"
AI_MODEL=gpt-3.5-turbo  # Specific model (see examples below)

# 🔑 REQUIRED: API Keys (depending on provider)
OPENAI_API_KEY=your-openai-api-key-here
CLAUDE_API_KEY=your-claude-api-key-here

# 🌐 OPTIONAL: JPLensContext API connection (auto-configured for local development)
# JPLENS_API_URL=http://localhost:8000

# ⚙️ ADVANCED: Only modify if you know what you're doing
# DEBUG=true
# LOG_LEVEL=INFO
# HOST=localhost
# PORT=8001
